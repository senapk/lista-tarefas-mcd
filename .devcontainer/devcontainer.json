{
  "name": "Task List",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "uv sync --locked",
  "postStartCommand": "bash .devcontainer/start-server.sh",
  "postAttachCommand": "if [ -n \"${CODESPACE_NAME:-}\" ]; then gh codespace ports visibility 5000:public --codespace \"$CODESPACE_NAME\"; fi",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Task List",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
